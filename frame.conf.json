{
    "version": "1.0",
    "description": "Frame OS - Yocto build configuration for Raspberry Pi Zero 2W (Inky Impression), release 6.0 \"wrynose\"",
    "sources": {
        "bitbake": {
            "git-remote": {
                "branch": "2.18",
                "rev": "2.18",
                "uri": "https://git.openembedded.org/bitbake"
            }
        },
        "openembedded-core": {
            "git-remote": {
                "branch": "wrynose",
                "rev": "wrynose",
                "uri": "https://git.openembedded.org/openembedded-core"
            }
        },
        "meta-yocto": {
            "git-remote": {
                "branch": "wrynose",
                "rev": "wrynose",
                "uri": "https://git.yoctoproject.org/meta-yocto"
            }
        },
        "yocto-docs": {
            "git-remote": {
                "branch": "wrynose",
                "rev": "wrynose",
                "uri": "https://git.yoctoproject.org/yocto-docs"
            }
        },
        "meta-openembedded": {
            "git-remote": {
                "branch": "wrynose",
                "rev": "wrynose",
                "uri": "https://git.openembedded.org/meta-openembedded"
            },
            "path": "openembedded-core/meta-openembedded"
        },
        "meta-raspberrypi": {
            "git-remote": {
                "branch": "wrynose",
                "rev": "wrynose",
                "uri": "https://git.yoctoproject.org/meta-raspberrypi"
            },
            "path": "openembedded-core/meta-raspberrypi"
        },
        "meta-frame": {
            "git-remote": {
                "branch": "main",
                "rev": "main",
                "uri": "https://github.com/josephabbey/meta-frame.git"
            }
        }
    },
    "bitbake-setup": {
        "configurations": [
            {
                "oe-template": "frame-default",
                "configurations": [
                    {
                        "description": "Frame OS on Poky reference distribution",
                        "name": "frame"
                    },
                    {
                        "description": "Frame OS on Poky with internet sstate acceleration",
                        "name": "frame-with-sstate",
                        "oe-fragments": [
                            "core/yocto/sstate-mirror-cdn"
                        ]
                    }
                ],
                "description": "Frame OS - Yocto build for Raspberry Pi Zero 2W",
                "name": "frame-os",
                "oe-fragments-one-of": {
                    "machine": {
                        "description": "Target machines",
                        "options": [
                            {
                                "description": "Raspberry Pi Zero 2W Frame Dev (UART + USB Ethernet Gadget + SSH)",
                                "name": "machine/raspberrypi0-2w-64-frame-dev"
                            },
                            {
                                "description": "Raspberry Pi Zero 2W Frame Production",
                                "name": "machine/raspberrypi0-2w-64-frame"
                            }
                        ]
                    },
                    "distro": {
                        "description": "Target distributions",
                        "options": [
                            {
                                "description": "Yocto Project Reference Distro",
                                "name": "distro/poky"
                            }
                        ]
                    }
                },
                "setup-dir-name": "frame"
            }
        ]
    }
}